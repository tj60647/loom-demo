# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
# Playwright output — regenerated on every run, so tracking it means a dirty
# tree after each test and conflicts whenever two people run the suite.
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
# Holds a LIVE session token, rewritten by each run. Never commit it: a token
# pushed here is a valid credential for anyone who can read the repo.
/playwright/.auth/
# Session artifacts (snapshots, console logs) from the Playwright MCP browser.
/.playwright-mcp/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# Reading PDFs. Production readings live in the private Vercel Blob store, never
# on disk (see src/lib/storage.ts). The only thing this directory is still for is
# scripts/seed-sources.ts, which needs the three seed PDFs locally to populate a
# fresh database. Those are published, copyrighted course readings and this repo
# is public, so they are deliberately untracked — supply your own copies.
/storage/readings/*
!/storage/readings/.gitkeep

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel

# Tesseract downloads its language data next to the process on first use.
# Regenerated on demand (5MB for English), and nothing in the repo depends on it.
eng.traineddata
*.traineddata
