# The pdf.js worker is a build artifact copied verbatim out of node_modules
# (scripts/copy-pdf-worker.mjs). core.autocrlf is on for this checkout, and
# .mjs is treated as text, so without this git would rewrite the line endings
# of a 1MB minified file on every checkout — a needless diff on an asset that
# should be byte-identical to what npm installed.
public/pdf.worker.min.mjs -text -diff

# The WASM codecs beside it, copied by the same script three lines further
# down, have the same problem: the four LICENSE files and the .js fallback are
# text, arrive from node_modules with LF, and autocrlf wants CRLF in the
# worktree — so every `npm run dev` leaves them permanently "modified" with an
# empty diff. Verified 2026-08-18: index blob, worktree raw and worktree
# filtered all hash to eec8246 for LICENSE_QCMS, with zero CRs on either side.
public/pdf-wasm/** -text -diff
