# Copy to .env.local and fill in. Everything here is for LOCAL DEVELOPMENT.
#
# The one rule that protects production: local points at the Neon `dev`
# branch, never `main`. `npm run seed:demo` WIPES the demo course on whatever
# database DATABASE_URL names — aimed at main, that is production data.
# (docs/deployments.md has the full environment table.)

# Neon `dev` branch, pooled. From a teammate, or:
#   neonctl connection-string dev --database-name loom-db --pooled
DATABASE_URL=

# Any random string is fine locally: `openssl rand -base64 32`
NEXTAUTH_SECRET=

# Protocol included — its absence (not the port) is the classic breakage.
# On Windows, port 3000 sometimes sits in a Hyper-V excluded range; run
# `$env:PORT='3100'; npm run dev -- -p 3100` and adjust this to match.
NEXTAUTH_URL=http://localhost:3000

# Real GitHub OAuth never runs locally — an OAuth app holds one callback URL,
# and ours point at the deployed environments. Sign in locally through the
# test backdoor instead: GET /api/auth/test-login (admin) or ?as=testa
# (learner). It exists only in dev builds; deployed builds answer 403.
GITHUB_ID=local-dummy
GITHUB_SECRET=local-dummy

# The one shared blob store (see deployments.md invariant 4) — required to
# open reading PDFs locally. From Vercel, or a teammate.
BLOB_READ_WRITE_TOKEN=
BLOB_STORE_ID=

# Optional: enables the extraction judge, Draft from PDF, and rescoring.
# Without it those degrade politely; everything else works.
OPENROUTER_API_KEY=
